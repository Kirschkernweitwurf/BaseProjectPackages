/*
 * Shape only for the assembly graph: the GraphView pieces that the shared sheet cannot reach,
 * because they are named children Unity builds inside a Node rather than elements this tool
 * creates and can put a class on.
 *
 * No colors here. Everything colored is either painted from the palette in AssemblyGraphNode, or
 * carries one of the shared base- classes and is painted by EditorUssTheme.
 */

.assembly-node > #node-border {
    border-radius: 8px;
    opacity: 1;
}

.assembly-node #title {
    -unity-font-style: bold;
}

.assembly-node #collapse-button {
    background-color: rgba(0, 0, 0, 0);
}

.has-issues > #node-border {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
}

.is-focused > #node-border {
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
}

.kind-label {
    margin-left: 6px;
    margin-top: 4px;
}

.action-row {
    flex-direction: row;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 4px;
}

.focus-button,
.go-to-button {
    flex-grow: 1;
    margin-left: 2px;
    margin-right: 2px;
}

.clean-button {
    margin-left: 6px;
    margin-right: 6px;
    margin-top: 4px;
    margin-bottom: 2px;
}

.unused-header {
    margin-left: 6px;
    margin-top: 6px;
    -unity-font-style: bold;
}

.unused-line {
    margin-left: 14px;
    margin-right: 6px;
    font-size: 11px;
}